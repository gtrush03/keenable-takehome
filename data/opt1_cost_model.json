{
  "meta": {
    "name": "Galactica build-vs-buy, freshness and token-yield model",
    "version": "1.0",
    "date": "2026-10-01",
    "currency": "USD",
    "convention": "Every input is [low, mid, high]. 'src' lists fact ids in data/opt1_facts.json or reference numbers in research/parts/B_cost_inputs.md (prefix B#). 'ASSUMPTION' marks inputs with no direct source; the range is the claim.",
    "sampling": "Monte Carlo draws each ranged input from a triangular(low, mid, high). Build cost lines share a Gaussian copula with rho = 0.5 (a lab that overspends on one line tends to overspend on others)."
  },

  "galactica": {
    "stock_docs": {"value": 100e9, "src": ["Keenable Galactica card (George's Downloads, one tile): 100B docs"]},
    "flow_docs_per_month": {"value": 20e9, "src": ["Keenable Galactica card: +20B/mo"]},
    "price_usd_per_year": {"range": [1.0e6, 1.5e6, 2.0e6], "src": ["Keenable Galactica card: $1-2M/yr"]},
    "delivery_cadence_days": {"value": 30, "src": ["Keenable Galactica card: monthly dumps"]},
    "dump_processing_lag_days": {"range": [2, 5, 10], "src": ["ASSUMPTION: card says parsed at fetch; time from dump cut to bucket availability"]},
    "novel_share_of_flow": {"range": [0.20, 0.35, 0.50], "src": ["ASSUMPTION anchored on A02 (27% new URLs in a CC crawl) and Epoch 0-10%/yr stock growth (E15); Keenable must publish the real first-seen rate"]}
  },

  "common_crawl": {
    "pages_per_crawl": {"range": [1.97e9, 2.17e9, 2.64e9], "src": ["A01", "A07", "A10"]},
    "new_urls_per_crawl": {"range": [0.587e9, 0.70e9, 1.05e9], "src": ["A02", "A05", "A06", "A07"]},
    "crawls_per_year": {"value": 12, "src": ["A11"]},
    "crawl_window_days": {"value": 14, "src": ["A01: crawled Sep 4-17 2026"]},
    "release_lag_days_after_crawl_end": {"range": [2, 5, 11], "src": ["A01: Sep 17 -> Sep 19", "A03"]},
    "unique_doc_pool": {"value": 200e9, "src": ["A22: DCLM-Pool, all CC before 2023 = 200B docs"]},
    "price_usd_per_year": {"value": 0, "src": ["C15", "C18"]}
  },

  "tokens": {
    "tokens_per_doc_raw": {"range": [600, 900, 1200], "src": ["A23", "A27", "A28", "A29", "research/parts/CD C5 table"]}
  },

  "funnel": {
    "note": "Stages applied in order to the 100B-doc stock and to the monthly novel flow. Keep = fraction of tokens retained.",
    "stages": [
      {"name": "Exact / content-hash dedup (index is URL-unique already)", "keep": [0.85, 0.92, 0.98], "src": ["ASSUMPTION; Dolma exact dedup removed 14.9% at doc level after URL dedup (A30)"]},
      {"name": "Language ID + heuristic quality rules (Gopher / C4 / FineWeb)", "keep": [0.45, 0.60, 0.75], "src": ["A17 (FineWeb custom filters remove ~22%)", "C4 terminal-punctuation filter ~30% (A17)", "E15 (Epoch usable share 10-40% after dedup+filter)"]},
      {"name": "Fuzzy dedup (MinHash LSH, 5-gram, ~0.75-0.8 Jaccard)", "keep": [0.40, 0.60, 0.75], "src": ["A16", "A27 (RedPajama-V2 dedup removed ~40% of tokens)", "A35 (cross-dedup of already-deduped sets removed 11%)"]},
      {"name": "PII scrub + safety / toxicity filter", "keep": [0.95, 0.97, 0.99], "src": ["ASSUMPTION"]},
      {"name": "Benchmark decontamination (8/13-gram overlap)", "keep": [0.995, 0.998, 0.999], "src": ["A25", "A31", "A39", "ASSUMPTION for share removed"]}
    ],
    "quality_profiles": {
      "light (RedPajama-V2 / Nemotron-CC style: keep most, weight by signals)": {"classifier_keep": [1.0, 1.0, 1.0], "src": ["A26", "A32", "A33"]},
      "edu-lenient (FineWeb-Edu score>=2)": {"classifier_keep": [0.30, 0.36, 0.40], "src": ["A18", "A19"]},
      "aggressive (DCLM top-10% / FineWeb-Edu score>=3)": {"classifier_keep": [0.087, 0.10, 0.12], "src": ["A19", "A24", "A33"]}
    }
  },

  "build": {
    "volume_docs_per_month": 20e9,
    "note": "Monthly cost lines in $K for an in-house crawl that matches Galactica's flow (20B pages/mo, ~7,700 pages/s), extracted text kept 12 months, raw HTML hot 1 month. Line values from research/parts/B_cost_inputs.md section 10.1, which itemises each to a price page.",
    "fixed_lines_k_per_month": {
      "team": {"range": [150, 379, 900], "basis": "4 / 7 / 12 FTE at $450K / $650K / $900K loaded", "src": ["E18", "E19", "C45", "B#48-60"]},
      "legal_compliance_pii": {"range": [13, 33, 83], "basis": "$150K / $400K / $1M per year", "src": ["ASSUMPTION", "B29-B31 (AI Act summary + opt-out duty)"]},
      "tooling_observability": {"range": [3, 10, 30], "basis": "~10% of infra", "src": ["ASSUMPTION"]}
    },
    "variable_lines_k_per_month_at_20B": {
      "bandwidth": {"range": [1, 1, 5], "src": ["C35", "C43", "B#5-13"]},
      "crawl_compute": {"range": [5, 13, 40], "src": ["C38", "C39", "C40", "E17", "B#14"]},
      "proxies_antibot": {"range": [3, 42, 300], "src": ["C21", "C22", "C24", "B#25-29"]},
      "js_rendering": {"range": [4, 16, 64], "src": ["C32", "B#14", "ASSUMPTION 2-10% of pages need JS"]},
      "parse_langid_filters": {"range": [3, 10, 70], "src": ["E20", "B#35"]},
      "quality_classifier_gpu": {"range": [0, 6, 16], "src": ["A20", "ASSUMPTION H100 $2-3.5/h"]},
      "dedup": {"range": [5, 15, 50], "src": ["E21", "A16"]},
      "storage_raw_html_1mo": {"range": [4, 17, 26], "src": ["C33", "C34", "C42", "C17"]},
      "storage_text_12mo": {"range": [3, 12, 25], "src": ["C33", "C34", "C42"]},
      "delivery_egress": {"range": [0, 6, 75], "src": ["C35", "C37", "C41"]}
    },
    "existing_team_marginal_fte": {"range": [1, 2, 3], "loaded_k_per_fte_year": [450, 650, 900], "src": ["ASSUMPTION: a lab that already runs GPTBot/ClaudeBot-class crawling adds 1-3 people for a 20B/mo text feed"]},
    "time_to_first_dump_months": {"range": [4, 8, 14], "src": ["ASSUMPTION: hire + build frontier/politeness + extraction + dedup + compliance review; CC itself needed years (B9)"]},
    "cross_checks": [
      {"what": "Ahrefs colo infra per 1B pages", "value_usd": 5500, "src": ["E17"]},
      {"what": "Common Crawl all-in per 1B pages (AWS hosting donated)", "value_usd": 51000, "src": ["E16"]}
    ]
  },

  "freshness": {
    "model_cutoff_to_release_gap_months": {
      "GPT-5": 10, "GPT-5.5": 4.7, "Gemini 3 Pro": 10, "Llama 4": 8,
      "src": ["E01", "E02", "E03", "E04"]
    },
    "continual_pretraining_monthly_budget_tokens": {"range": [1.0e11, 3.0e11, 5.0e11], "src": ["E07 (TiC-LM: 100B-500B new tokens/month)"]},
    "horizon_months": 24
  }
}
